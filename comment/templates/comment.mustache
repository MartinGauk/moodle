{{!
    @template core_comment/comment

    Moodle comment template.

    The purpose of this template is to render a single comment, without its replies.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-commentbody
    * data-commentreplies
    * data-commentreplyform

    Context variables required for this template:
    * isediting Boolean specifying whether the comment is being edited
    * showreplies Boolean specifing whether replies are displayed
    * showreplyform Boolean specifing whether the reply form is displayed
    * Comment as exported by core_comment\external\comment_exporter.php

    Example context (json):
    {
        "isediting": false,
        "showreplies": false,
        "showreplyform": false,
        // TODO fill with example comment
    }
}}
<div class="core_comment_comment {{#pseudonym}}core_comment_comment_pseudonymous{{/pseudonym}} d-flex flex-row">
    <div class="core_comment_comment_avatar flex-grow-0">
        {{{avatar}}}
    </div>
    <div class="flex-grow-1" style="overflow-x: hidden;">
        <div class="core_comment_comment_header d-flex flex-row flex-nowrap">
            <div class="flex-grow-1">
                <span class="core_comment_comment_author">
                    {{#profileurl}}
                        <a href="{{profileurl}}">{{fullname}}</a>
                    {{/profileurl}}
                    {{^profileurl}}
                        <span class="text-danger">{{fullname}}</span>
                    {{/profileurl}}
                </span>
                -
                <span class="d-inline-block">{{timecreatedtext}}</span>
            </div>
            <div class="core_comment_comment_settings flex-grow-0 btn-group">
                <a class="action-icon clickable text-muted" data-toggle="dropdown" role="button">
                    <i class="icon fa fa-ellipsis-v fa-fw"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right"> {{! TODO dropdown menu get's cut off because of overflow-x: hidden on row }}
                    {{#canedit}}{{^isediting}}
                        <a href="#" class="dropdown-item" data-editcomment="{{id}}">
                            <i class="icon fa fa-pencil fa-fw"></i> {{# str }} edit, core_comment {{/ str }}
                        </a>
                    {{/isediting}}{{/canedit}}
                    {{#candelete}}
                        <a href="#" class="dropdown-item" data-deletecomment="{{id}}">
                            <i class="icon fa fa-trash fa-fw"></i> {{# str }} delete, core_comment {{/ str }}
                        </a>
                    {{/candelete}}
                </div>
            </div>
        </div>

        {{#isediting}}
            <div data-commenteditform="{{id}}"></div>
        {{/isediting}}
        {{^isediting}}
            <div data-commentbody="{{id}}"></div>
        {{/isediting}}

        <div class="core_comment_comment_footer">
            {{#canreply}}
                <a href="#" data-showreplyform="{{id}}">{{# str }} reply, core_comment {{/ str }}</a>
            {{/canreply}}
            {{#replies}}
                <span class="d-inline-block">
                    {{^showreplies}}
                        <a href="#" data-showreplies="{{id}}">▼ {{ replies }} {{# str }} nreplies, core_comment {{/ str }}</a>
                    {{/showreplies}}
                    {{#showreplies}}
                        <a href="#" data-hidereplies="{{id}}">▲ {{ replies }} {{# str }} nreplies, core_comment {{/ str }}</a>
                    {{/showreplies}}
                </span>
            {{/replies}}
        </div>

        {{#showreplies}}
            <div data-commentreplies="{{id}}"></div>
        {{/showreplies}}
        {{#showreplyform}}
            <div data-commentreplyform="{{id}}"></div>
        {{/showreplyform}}
    </div>
</div>