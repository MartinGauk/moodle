{{!
    @template core_comment/comment

    Moodle comment component template.

    The purpose of this template is to render a single comment, without its replies.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * isediting Boolean specifying whether the comment is being edited
    * showreplies Boolean specifing whether replies are displayed
    * showreplyform Boolean specifing whether the reply form is displayed
    * showsettings Boolean specifying whether the settings menu should be shown
    * showitemlink Boolean specifying whether a link to the context where the comment was posted should be shown
    * Comment as exported by core_comment\external\comment_exporter.php

    Example context (json):
    {
        "isediting": false,
        "showreplies": false,
        "showreplyform": false,
        "showitemlink": false,
        // TODO fill with example comment
    }
}}
<div class="core_comment_comment {{#pseudonym}}pseudonymous{{/pseudonym}}">
    {{#showitemlink}}
        {{$itemlink}}
            <div class="comment-item-link">
                <div data-for="commentitemlink" data-commentid="{{id}}"></div>
            </div>
        {{/itemlink}}
    {{/showitemlink}}
    {{$row}}
        <div class="comment-row">
            {{$avatar}}
                <div class="comment-avatar">
                    {{{avatar}}}
                </div>
            {{/avatar}}
            {{$container}}
                <div class="comment-container">
                    {{$header}}
                        <div class="comment-header">
                            <div data-for="commentheader" data-commentid="{{id}}"></div>
                        </div>
                    {{/header}}

                    {{$body}}
                        <div class="comment-body">
                            {{#isediting}}
                                <div data-for="commenteditform" data-commentid="{{id}}"></div>
                            {{/isediting}}
                            {{^isediting}}
                                <div data-for="commentbody" data-commentid="{{id}}"></div>
                            {{/isediting}}
                        </div>
                    {{/body}}

                    {{$footer}}
                        <div class="comment-footer">
                            {{#canreply}}
                                {{$replycontrol}}
                                    <a href="#" class="comment-reply-control" data-for="showreplyform">{{# str }} reply, core_comment {{/ str }}</a>
                                {{/replycontrol}}
                            {{/canreply}}
                            {{#replies}}
                                {{$repliescontrol}}
                                    <span class="comment-replies-control">
                                        {{^showreplies}}
                                            <a href="#" data-for="showreplies">▼ {{ replies }} {{# str }} nreplies, core_comment {{/ str }}</a>
                                        {{/showreplies}}
                                        {{#showreplies}}
                                            <a href="#" data-for="hidereplies">▲ {{ replies }} {{# str }} nreplies, core_comment {{/ str }}</a>
                                        {{/showreplies}}
                                    </span>
                                {{/repliescontrol}}
                            {{/replies}}
                        </div>
                    {{/footer}}

                    {{#showreplies}}
                        <div class="comment-replies-box">
                            <div data-for="commentreplies" data-replytoid="{{id}}"></div>
                        </div>
                    {{/showreplies}}
                    {{#showreplyform}}
                        <div class="comment-reply-box">
                            <div data-for="commentreplyform" data-replytoid="{{id}}"></div>
                        </div>
                    {{/showreplyform}}
                </div>
            {{/container}}
        </div>
    {{/row}}
</div>