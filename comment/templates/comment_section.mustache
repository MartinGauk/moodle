{{!
    @template core_comment/comment_section

    Moodle comment section component template.

    The purpose of this template is to render the structure of a comment section, i.e. the location of the comment form
    and comment list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * startatbottom Boolean specifying whether the comment form is below the comment list
    * fillheight Boolean specifying whether the comment section should fill the available height of it's parent element
    * showform Boolean specifying whether the comment form should be shown
    * section Comment section as exported by core_comment\external\comment_section_exporter.php

    Example context (json):
    {
        "startatbottom": false,
        "fillheight": false,
        "showform": true,
        "section": {
            // TODO fill with example section
        }
    }
}}
<div class="core_comment_comment_section{{#fillheight}} fill-height{{/fillheight}}{{#startatbottom}} start-at-bottom{{/startatbottom}}">
    {{^startatbottom}}
        {{#showform}}
            <div class="comment-section-form" data-for="commentform"></div>
        {{/showform}}
    {{/startatbottom}}
    <div class="comment-section-list-container">
        <div class="comment-section-list"
            {{#maxlistheight}} style="max-height: {{maxlistheight}}px;"{{/maxlistheight}}
             data-for="commentlist">
        </div>
    </div>
    {{#startatbottom}}
        {{#showform}}
            <div class="comment-section-form" data-for="commentform"></div>
        {{/showform}}
    {{/startatbottom}}
</div>