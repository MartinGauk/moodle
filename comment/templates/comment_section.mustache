{{!
    @template core_comment/comment_section

    Moodle comment section template.

    The purpose of this template is to render the structure of a comment section, i.e. the location of the comment form
    and comment list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-commentlist
    * data-commentform

    Context variables required for this template:
    * startatbottom Boolean specifying whether the comment form is below the comment list
    * fillheight Boolean specifying whether the comment section should fill the available height of it's parent element
    * Comment section as exported by core_comment\external\comment_section_exporter.php

    Example context (json):
    {
        "startatbottom": false,
        "fillheight": false,
        // TODO fill with example section
    }
}}
<div class="core_comment_comment_section"
     {{#fillheight}}style="height: 100%; display: flex; flex-flow: column nowrap;"{{/fillheight}}>

    {{^startatbottom}}
        {{#canpost}}
            <div data-commentform {{#fillheight}}style="flex: 0 1 auto;"{{/fillheight}}></div>
        {{/canpost}}
    {{/startatbottom}}
    {{#fillheight}}
        <div style="flex: 1 1 1px; overflow-y: auto;
             {{#startatbottom}}display: flex; flex-flow: column-reverse;{{/startatbottom}}">
            <div data-commentlist></div>
        </div>
    {{/fillheight}}
    {{^fillheight}}
        <div data-commentlist></div>
    {{/fillheight}}
    {{#startatbottom}}
        {{#canpost}}
            <div data-commentform {{#fillheight}}style="flex: 0 1 auto;"{{/fillheight}}></div>
        {{/canpost}}
    {{/startatbottom}}
</div>