{{!
    @template core_comment/comment_list

    Moodle comment list component template.

    The purpose of this template is to render a list of comments and their replies.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * replyto Comment that these are replies to as exported by core_comment\external\comment_exporter.php (optional)
    * comments Array of comments containing only the "id" field
    * count Size of comments array
    * moreavailablebefore Boolean specifying whether there are more comments available in this list before the first
    * moreavailableafter Boolean specifying whether there are more comments available in this list after the last
    * startatbottom Boolean specifying whether the comment list is displayed bottom-first

    Example context (json):
    {
        "replyto": // TODO fill with example comment
        "comments": [
            {"id": 42},
            {"id": 43}
        ],
        "count": 1,
        "moreavailablebefore": false,
        "moreavailableafter": true,
        "startatbottom": false
    }
}}
<div class="core_comment_comment_list{{#replyto}} replies{{/replyto}}{{#startatbottom}} start-at-bottom{{/startatbottom}}">
    {{^startatbottom}}{{#highlightedcomment}}
        <div data-for="commenthighlight" data-commentid="{{id}}"></div>
    {{/highlightedcomment}}{{/startatbottom}}
    {{#moreavailableabove}}
        <div class="my-3">
            {{#loadingmoreabove}}
                <i class="icon fa fa-circle-o-notch fa-spin fa-fw ml-4"></i>
            {{/loadingmoreabove}}
            {{^loadingmoreabove}}
                <a href="#" data-for="loadmoreabove">{{#str}} loadmore, core_comment {{/str}}</a>
            {{/loadingmoreabove}}
        </div>
    {{/moreavailableabove}}
    {{#count}}
        <div class="comment-list-comments">
            {{#comments}}
                <div data-for="comment" data-commentid="{{id}}">
                </div>
            {{/comments}}
        </div>
    {{/count}}
    {{^comments}}{{^highlightedcomment}}
        {{#str}} nocomments, core_comment {{/str}}
    {{/highlightedcomment}}{{/comments}}
    {{#moreavailablebelow}}
        <div class="my-3">
            {{#loadingmorebelow}}
                <i class="icon fa fa-circle-o-notch fa-spin fa-fw ml-4"></i>
            {{/loadingmorebelow}}
            {{^loadingmorebelow}}
                <a href="#" data-for="loadmorebelow">{{#str}} loadmore, core_comment {{/str}}</a>
            {{/loadingmorebelow}}
        </div>
    {{/moreavailablebelow}}
    {{#startatbottom}}{{#highlightedcomment}}
        <div data-for="commenthighlight" data-commentid="{{id}}"></div>
    {{/highlightedcomment}}{{/startatbottom}}
</div>