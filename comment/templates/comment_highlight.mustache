{{!
    @template core_comment/comment_highlight

    Moodle comment highlight component template.

    The purpose of this template is to render a highlighted comment as part of a comment list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * Highlighted comment as exported by core_comment\external\comment_exporter.php

    Example context (json):
    {
        // TODO fill with example comment
    }
}}
<div class="core_comment_comment_highlight {{#replytoid}}reply{{/replytoid}}">
        {{^replytoid}}{{#str}} highlightedcomment, core_comment {{/str}}{{/replytoid}}
        {{#replytoid}}{{#str}} highlightedreply, core_comment {{/str}}{{/replytoid}}
        <div data-for="highlightedcomment" data-commentid="{{id}}">
        </div>
        {{^replytoid}}
            <a class="btn btn-secondary" href="#" data-for="dismisshighlightedcomment">
                {{#str}} dismisshighlightedcomment, core_comment {{/str}}
            </a>
        {{/replytoid}}
</div>