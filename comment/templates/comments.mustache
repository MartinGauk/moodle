{{!
    @template core_comment/section

    Moodle comment section template.

    The purpose of this template is to render a comment section.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="core_comment_comments">
    {{#modal}}
        <a href='#' id="comments_{{uniqid}}">{{modalbuttontext}}</a>
    {{/modal}}
    {{^modal}}
        <div id="comments_{{uniqid}}">
            <i class="icon fa fa-circle-o-notch fa-spin fa-fw"></i>
        </div>
    {{/modal}}
</div>
{{#js}}
    require(['core_comment/comments'], function(comments) {
        const commentsEl = document.getElementById("comments_{{uniqid}}");
        const options = {
            component: "{{component}}",
            commentArea: "{{area}}",
            contextId: {{contextid}},
        {{#section}}
            itemId: {{itemid}},
        {{/section}}
            fillHeight: {{fillheight}},
            startAtBottom: {{startatbottom}},
            sortDirection: "{{sortdirection}}",
            maxListHeight: {{maxlistheight}},
            pageSize: {{pagesize}},
            showPictures: {{showpictures}}
        };
        {{#modal}}
            comments.initCommentModal(commentsEl, options);
        {{/modal}}
        {{^modal}}
            comments.initCommentSection(commentsEl, options);
        {{/modal}}
    });
{{/js}}