{{!
    @template core_comment/comment_header

    Moodle comment header component template.

    The purpose of this template is to render the header of a single comment.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * isediting Boolean specifying whether the comment is being edited
    * wasmodified Boolean specifying whether this comment was modified
    * Comment as exported by core_comment\external\comment_exporter.php

    Example context (json):
    {
        "isediting": false,
        "wasmodified": false,
        // TODO fill with example comment
    }
}}
<div class="core_comment_comment_header">
    <span class="comment-header-left">
        <span class="comment-author">
            {{#profileurl}}
                <a href="{{profileurl}}">{{fullname}}</a>
            {{/profileurl}}
            {{^profileurl}}
                <span class="text-danger">{{fullname}}</span>
            {{/profileurl}}
        </span>
        <span class="comment-timecreated">{{timecreatedtext}}</span>
        {{#wasmodified}}
            <span class="comment-modified">
                <a class="btn btn-none p-0 text-muted" role="button" data-container="body" data-toggle="popover"
                        data-content="{{#cleanstr}} editedby, core_comment, {
                        "usermodified": {{#quote}}{{usermodifiedfullname}}{{/quote}},
                        "timemodified": {{#quote}}{{timemodifiedtext}}{{/quote}}
                    }{{/cleanstr}}"
                    data-html="true" tabindex="0" data-trigger="hover focus">
                    <i class="fa fa-pencil fa-fw"></i>
                </a>
            </span>
        {{/wasmodified}}
    </span>
    <div class="comment-header-right">
        <div id="commentsettings{{uniqid}}" class="comment-settings btn-group dropdown">
                <a class="action-icon clickable text-muted" data-toggle="dropdown" role="button" tabindex="0">
                    <i class="icon fa fa-ellipsis-v fa-fw"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    {{#canedit}}{{^isediting}}
                        <a href="#" class="dropdown-item" data-for="editcomment">
                            <i class="icon fa fa-pencil fa-fw"></i> {{# str }} edit, core_comment {{/ str }}
                        </a>
                    {{/isediting}}{{/canedit}}
                    {{#candelete}}
                        <a href="#" class="dropdown-item" data-for="deletecomment">
                            <i class="icon fa fa-trash fa-fw"></i> {{# str }} delete, core_comment {{/ str }}
                        </a>
                    {{/candelete}}
                    <a href="#" class="dropdown-item" data-for="copycommenturl">
                        <i class="icon fa fa-link fa-fw"></i> {{# str }} copycommenturl, core_comment {{/ str }}
                    </a>
                </div>
            </div>
    </div>
</div>
{{#js}}
require(['jquery'], function($) {
    const settings = $('#commentsettings{{uniqid}}');
    const settingsMenu = settings.find('.dropdown-menu');
    settings.on('show.bs.dropdown', () => {
        $('body').append(settingsMenu);
    });
    settings.on('hidden.bs.dropdown', () => {
        settings.append(settingsMenu);
    });
});
{{/js}}