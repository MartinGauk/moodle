{{!
    @template core_comment/modal_comment_section

    Moodle comment section modal template.

    The purpose of this template is to render a modal displaying a comment section.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="modal moodle-has-zindex core_comment_modal_comment_section" data-region="modal-container" aria-hidden="true" role="dialog">
    <div class="modal-dialog {{$classes}}{{classes}}{{/classes}}" role="document" data-region="modal" aria-labelledby="{{uniqid}}-modal-title" tabindex="0">
        <div class="modal-content">
            <div class="modal-header {{$headerclasses}}{{headerclasses}}{{/headerclasses}}" data-region="header">
{{!TODO Popup Breite}}
                {{$header}}
                    <h5 id="{{uniqid}}-modal-title" class="modal-title" data-region="title">{{$title}}{{#str}} comments {{/str}}{{/title}}</h5>
                {{/header}}
                <button type="button" class="close" data-action="hide" aria-label={{#quote}}{{#str}}closebuttontitle{{/str}}{{/quote}}>
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" data-region="body">
                {{$body}}
                    <div class="container h-100">
                        <div class="h-100" data-commentsection></div>
                    </div>
                {{/body}}
            </div>
            <div class="modal-footer" data-region="footer">
                {{$footer}}
                {{/footer}}
            </div>
        </div>
    </div>
</div>