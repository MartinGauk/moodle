{{!
    @template core_comment/comment_form

    Moodle comment form template.

    The purpose of this template is to render a form for creating or updating a comment or reply.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * canpost Boolean specifying whether the user can post comments here
    * allowpseudonym Boolean specifying whether the user may use a pseudonym
    * allowrealname Boolean specifying whether the user may use their real name
    * comment Comment to be edited as exported by core_comment\external\comment_exporter.php (optional)
    * replyto Comment that this is a reply to as exported by core_comment\external\comment_exporter.php (optional)

    Example context (json):
    {
        "canpost": true,
        "allowpseudonym": true,
        "allowrealname": true,
        "comment": {
            // TODO fill with example comment
        },
        "replyto": {
            // TODO fill with example comment
        }
    }
}}
<div class="core_comment_comment_form">
    {{#canpost}}
        <form class="mform">
            {{#allowpseudonym}}
                <div class="form-check">
                    <input id="pseudonymToggle{{uniqid}}" type="checkbox"
                           {{#comment.pseudonymous}}checked disabled{{/comment.pseudonymous}}
                           {{^comment}}{{^allowrealname}}checked disabled{{/allowrealname}}{{/comment}}
                           name="pseudonymous" class="form-check-input">
                    <label for="pseudonymToggle{{uniqid}}"> {{# str }} useapseudonym, core_comment {{/ str }}</label>
                </div>
            {{/allowpseudonym}}
            <div class="form-group">
                <label for="contentInput{{uniqid}}" class="sr-only">{{# str }} content, core_comment {{/ str }}</label>
                <div class="form-inline">
                    <textarea id="contentInput{{uniqid}}" placeholder="{{# str }} writeacomment, core_comment {{/ str }}"
                              class="form-control w-100"
                              name="content">{{#comment}}{{content}}{{/comment}}</textarea>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" class="btn btn-primary" value="{{#comment}}{{# str }} updatecomment, core_comment {{/ str }}{{/comment}}{{^comment}}{{# str }} postcomment, core_comment {{/ str }}{{/comment}}">
                <input type="button" data-cancelcommentform class="btn btn-secondary" value="{{# str }} cancel, core {{/ str }}">
            </div>
        </form>
    {{/canpost}}
</div>